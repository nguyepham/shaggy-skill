{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --event session-start",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --event session-end",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --tool Write",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --tool Edit",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --tool MultiEdit",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --tool NotebookEdit",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --tool Bash",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{plugin_dir}/rebon-guard-hook.mjs\" --tool PowerShell",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
